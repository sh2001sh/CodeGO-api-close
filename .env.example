# Generate two independent values with: openssl rand -base64 32
V3_SECRET_KEY=
V3_SESSION_SECRET=

# Isolated local development, used only by v3/deploy/compose.test.yaml.
V3_TEST_PG_PASSWORD=
V3_TEST_PORT=18083

# Image-only production template. Use one verified commit for every service.
V3_IMAGE_REPOSITORY=ghcr.io/sh2001sh/codego-api
V3_IMAGE_TAG=
V3_PUBLIC_URL=https://codegoai.com
V3_WEB_PORT=8080
V3_PG_DSN=
V3_REDIS_ADDR=
V3_REDIS_PASSWORD=
V3_TRUSTED_PROXY_CIDRS=

# Recalculate all service pools against the actual database connection budget.
V3_GATEWAY_PG_MAX_CONNS=4
V3_CONTROL_PG_MAX_CONNS=3
V3_WORKER_PG_MAX_CONNS=6
V3_LEDGER_CONSUMERS=2
V3_LEDGER_BATCH_SIZE=16
V3_AUDIT_SAMPLE_RETENTION_DAYS=30
